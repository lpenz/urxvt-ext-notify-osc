use warnings;
use strict;


sub dbg {
    my ($debug, @msg) = @_;
    return unless $debug;
    warn "[notify-osc] @msg\n";
}

sub on_osc_seq_perl {
    my ($self, $osc, $resp) = @_;

    # Match and capture payload after "notify;"
    return unless $osc =~ /^notify;(.*)/;

    my $debug = $self->resource("notify.debug") // 0;

    my $payload = $1 // '';

    # Split into summary and body (only first semicolon matters)
    my ($summary, $body) = split /(?<!\\);/, $payload, 2;
    s/\\;/;/g for ($summary, $body);

    # Ensure defined values
    $summary //= '';
    $body    //= '';

    # Trim whitespace and control chars
    for ($summary, $body) {
        next unless defined;
        s/[\x00-\x1F\x7F]//g;
        s/^\s+//;
        s/\s+\z//;
    }

    # Don't send empty notifications
    return unless length $summary;

    my @exec = ("notify-send", $summary);
    push @exec, $body if length $body;

    dbg($debug, "exec: @exec");

    $self->exec_async (@exec);

    $self->set_urgency(1);

    return 1;
}
